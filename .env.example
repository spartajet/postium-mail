# ============================================
# OAuth 客户端凭证配置
# ============================================
#
# 使用说明：
# 1. 复制此文件到 src-tauri/.env
# 2. 填写您在 Google Cloud Console 和 Azure Portal 注册应用时获得的凭证
# 3. src-tauri/.env 已在 .gitignore 中排除，不会被提交
#
# 注册地址：
# - Google: https://console.cloud.google.com/
#   应用类型: Desktop app
#   重定向 URI: http://localhost:36279/callback
#
# - Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
#   应用类型: Public client (desktop)
#   重定向 URI: http://localhost:36279/callback
#   重要: 在 "Authentication" 中勾选 "Allow public client flows"

# ========== Google Gmail ==========
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:36279/callback

# ========== Google Workspace ==========
GOOGLE_WORKSPACE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_WORKSPACE_CLIENT_SECRET=your-google-client-secret
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:36279/callback

# ========== Microsoft Outlook ==========
MICROSOFT_CLIENT_ID=your-microsoft-client-id
# Microsoft 公共客户端不需要 client_secret（留空即可）
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=http://localhost:36279/callback

# ========== Microsoft 365 ==========
MICROSOFT365_CLIENT_ID=your-microsoft-client-id
# Microsoft 公共客户端不需要 client_secret（留空即可）
MICROSOFT365_CLIENT_SECRET=
MICROSOFT365_TENANT=common
MICROSOFT365_REDIRECT_URI=http://localhost:36279/callback
