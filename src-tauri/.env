# Microsoft OAuth2 配置
# 桌面应用是公共客户端，不需要client_secret
# 在Azure Portal注册应用获取client_id: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=67acce3b-a85a-40c1-be02-44d954282442
MICROSOFT_TENANT=common
# 使用自定义 Deep Link 方案（需要在 Azure Portal 中注册此 URI）
MICROSOFT_REDIRECT_URI=postium-mail://oauth/callback

# OAuth Scopes (IMAP和SMTP访问权限)
# IMAP.AccessAsUser.All - 读取和管理邮箱中的所有邮件
# SMTP.Send - 发送邮件
# offline_access - 获取refresh_token以实现自动刷新
# profile, openid, email - 获取用户基本信息
MICROSOFT_SCOPES=https://outlook.office.com/SMTP.Send https://outlook.office.com/IMAP.AccessAsUser.All User.Read offline_access profile openid email

# OAuth 端点URL
MICROSOFT_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
