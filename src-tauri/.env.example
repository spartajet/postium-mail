# Microsoft / Outlook OAuth 配置
# 在 Azure Portal (https://portal.azure.com/) 创建 OAuth 应用
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=postium-mail://oauth/callback
MICROSOFT_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MICROSOFT_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token
# 默认 scopes（可覆盖）
MICROSOFT_SCOPES=https://outlook.office.com/SMTP.Send https://outlook.office.com/IMAP.AccessAsUser.All offline_access openid

# Google / Gmail OAuth 配置
# 在 Google Cloud Console (https://console.cloud.google.com/) 创建 OAuth 2.0 客户端
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_REDIRECT_URI=postium-mail://oauth/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# 默认 scopes（可覆盖）
GOOGLE_SCOPES=https://mail.google.com/ https://www.googleapis.com/auth/userinfo.email

# Google Workspace 企业配置（可选）
# GOOGLE_WORKSPACE_CLIENT_ID=your-google-workspace-client-id

# 应用配置
APP_ENV=development
LOG_LEVEL=debug
