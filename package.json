{
  "name": "postium-mail",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "packageManager": "bun@1.2.23",
  "scripts": {
    "dev": "./node_modules/.bin/vite dev",
    "build": "./node_modules/.bin/vite build",
    "preview": "./node_modules/.bin/vite preview",
    "check": "./node_modules/.bin/svelte-kit sync && ./node_modules/.bin/svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "./node_modules/.bin/svelte-kit sync && ./node_modules/.bin/svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "./node_modules/.bin/tauri",
    "test": "bun run test:frontend",
    "test:rust": "cd src-tauri && cargo test",
    "test:frontend": "./node_modules/.bin/svelte-kit sync && ./node_modules/.bin/vitest run",
    "test:watch": "./node_modules/.bin/svelte-kit sync && ./node_modules/.bin/vitest",
    "test:e2e": "cd e2e && bun run test",
    "test:all": "bun run test:rust && bun run test:frontend",
    "test:ci": "bun run test:rust && bun run test:frontend"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-positioner": "~2",
    "@tauri-apps/plugin-window-state": "~2",
    "@tiptap/core": "^3.21.0",
    "@tiptap/extension-placeholder": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@eslint/css": "^1.1.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.6.0",
    "bits-ui": "^2.16.5",
    "eslint": "^10.2.1",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
